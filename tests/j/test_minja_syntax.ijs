NB. ================================================================
NB. test_minja_syntax.ijs — full upstream test-syntax.cpp case suite
NB. (all 155 EXPECT_EQ render cases, incl. the 5 bindings cases and
NB. the newline-containing / trim_tmpl cases). Wired into run_all_tests.sh.
NB. Cases are generated by /tmp/minja_extract.py from the upstream oracle
NB. reference/minja/tests/test-syntax.cpp (see tests/j/minja_cases.ijs).
NB. Bindings are wired via from_json (JSON -> Value) + mkctx (Value -> Context).
NB. ================================================================
coclass 'inference'

load './tests/j/test_harness.ijs'
load './util/minja.ijs'
load './tests/j/minja_cases.ijs'

init_counters ''

streq =: 4 : '(x -: , y)'

run_cases =: 3 : 0
  i =. 0
  while. i < # CASES do.
    tmpl =. > i { CASES
    opts =. > (i+1) { CASES
    exp =. > (i+2) { CASES
    bind =. > (i+3) { CASES
    got =. ''
    err =. ''
    try.
      if. 0 = # bind do.
        if. 0 = # opts do.
          got =. '' render_minja_ tmpl
        else.
          got =. '' render_opt_minja_ (tmpl ; opts)
        end.
      else.
        ctx =. mkctx_minja_ (from_json_minja_ bind)
        if. 0 = # opts do.
          got =. ctx render_minja_ tmpl
        else.
          got =. ctx render_opt_minja_ (tmpl ; opts)
        end.
      end.
    catcht.
      err =. err_msg_g_minja_
    end.
    if. 0 < # err do.
      assert_test ((0) ; ('THROW ' , tmpl , '  [' , opts , ']  err=' , err))
    else.
      if. got streq exp do.
        assert_test ((1) ; (tmpl , '  [' , opts , ']'))
      else.
        assert_test ((0) ; ('MISMATCH ' , tmpl , '  [' , opts , ']  got=' , got , '  exp=' , exp))
      end.
    end.
    i =. i + 4
  end.
)

section_header 'Full test-syntax.cpp case suite (155 render cases)'
run_cases 0

show_summary 0
